#!/usr/bin/env python3
# qutebrowser userscript: fill the login form with a Bitwarden entry via rbw (bound to ,p).
# Linked into ~/.qutebrowser/userscripts/ by install.sh.
#   One entry for this site   -> username + password filled, TOTP (if any) copied.
#   Several                   -> numbered list in the statusbar and ":spawn --userscript
#                                rbw-fill " is preset: type the number, Enter.
# Entries are looked up by host, then by its parent domains (accounts.x.com -> x.com), with
# `rbw search` (name, username and URIs). A locked vault asks via pinentry (pinentry-mac).
# Filling is done with JS in the page (no keystrokes), so it works without focusing a field.
import base64
import json
import os
import subprocess
import sys
from urllib.parse import urlsplit

RBW = os.environ.get('RBW', '/opt/homebrew/bin/rbw')
PBCOPY = '/usr/bin/pbcopy'
FIFO = os.environ['QUTE_FIFO']
ENV = dict(os.environ, PATH='/opt/homebrew/bin:/usr/bin:/bin')  # rbw finds pinentry-mac


def cmd(line):
    with open(FIFO, 'a') as f:
        f.write(line + '\n')


def msg(kind, text):
    # one shell-quoted arg; ';;' would split it into two commands
    text = ' '.join(text.split()).replace(';;', ';').replace("'", '’')
    cmd(f"message-{kind} 'rbw: {text}'")


def rbw(*args):
    p = subprocess.run([RBW, *args], capture_output=True, text=True, env=ENV)
    if p.returncode != 0:
        raise RuntimeError(p.stderr.strip().splitlines()[-1] if p.stderr.strip() else 'failed')
    return p.stdout


def candidates(host):
    host = host.lower().removeprefix('www.')
    parts = host.split('.')
    return ['.'.join(parts[i:]) for i in range(len(parts) - 1)] or [host]


def matches(host):
    for term in candidates(host):
        out = rbw('search', '--fields', 'id,name,user,folder', term)
        rows = [line.split('\t') for line in out.splitlines() if line.strip()]
        if rows:
            return rows
    return []


# One line, no '{{' / '}}' (qutebrowser would read them as variables) and no newlines.
FILL_JS = (
    "(function(d){"
    "const vis=e=>e&&!e.disabled&&!e.readOnly&&e.getClientRects().length>0;"
    "const set=(e,v)=>{if(!e)return;e.focus();"
    "Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set.call(e,v);"
    "e.dispatchEvent(new Event('input',{bubbles:true}));"
    "e.dispatchEvent(new Event('change',{bubbles:true}));};"
    "const users='input[type=email],input[type=text],input[type=tel],input:not([type])';"
    "const a=document.activeElement;"
    "const pw=(vis(a)&&a.type==='password')?a:[...document.querySelectorAll('input[type=password]')].find(vis);"
    "const scope=(pw&&pw.form)||document;"
    "let u=[...scope.querySelectorAll(users)].filter(vis);"
    "if(pw)u=u.filter(e=>e.compareDocumentPosition(pw)&Node.DOCUMENT_POSITION_FOLLOWING);"
    # no password field yet (two-step logins): the focused field, else the last text field
    "const user=(!pw&&vis(a)&&a.matches(users))?a:(u.length?u[u.length-1]:null);"
    "if(d.user)set(user,d.user);"
    "if(pw)set(pw,d.pass);"
    "})"
)


def fill(entry_id, name):
    data = json.loads(rbw('get', '--raw', entry_id)).get('data') or {}
    payload = json.dumps({'user': data.get('username') or '', 'pass': data.get('password') or ''})
    b64 = base64.b64encode(payload.encode()).decode()
    decode = ("JSON.parse(new TextDecoder().decode(Uint8Array.from(atob('%s'),c=>c.charCodeAt(0))))"
              % b64)
    js = f'{FILL_JS}({decode})'
    while '{{' in js or '}}' in js:
        js = js.replace('{{', '{ {').replace('}}', '} }')
    cmd(f'jseval --quiet {js}')
    note = f'filled {name}'
    if data.get('totp'):
        code = rbw('code', entry_id).strip()
        subprocess.run([PBCOPY], input=code, text=True)
        note += ' (TOTP copied)'
    msg('info', note)


def main():
    host = urlsplit(os.environ.get('QUTE_URL', '')).hostname
    if not host:
        return msg('error', 'no host in this URL')
    rows = matches(host)
    if not rows:
        return msg('warning', f'no entry for {host}')
    if len(sys.argv) > 1:  # picked from the list
        try:
            rows = [rows[int(sys.argv[1]) - 1]]
        except (ValueError, IndexError):
            return msg('error', f'no entry number {sys.argv[1]}')
    if len(rows) == 1:
        entry_id, name = rows[0][0], rows[0][1]
        return fill(entry_id, name)
    for i, r in enumerate(rows, 1):
        user = r[2] if len(r) > 2 and r[2] else '-'
        folder = f' [{r[3]}]' if len(r) > 3 and r[3] else ''
        msg('info', f'{i}  {r[1]}  {user}{folder}')
    cmd('cmd-set-text -s :spawn --userscript rbw-fill')


try:
    main()
except RuntimeError as e:
    msg('error', str(e))
