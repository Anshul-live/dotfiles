brew "lazydocker"        # <space>od
brew "hurl"              # REST client (*.hurl files)
brew "jq"                # formats JSON responses
brew "cmake"             # C/C++ projects (:CMakeGen, build & debug)
brew "node"              # JS/TS tooling, npm-based language servers
brew "go"
cask "ghostty"
