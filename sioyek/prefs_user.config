# sioyek prefs (overrides the app's bundled prefs.config).
# macOS reads ~/.config/sioyek/prefs_user.config (checked in sioyek's main.cpp).
# Colours: "vague" palette as 0-1 floats.

# custom colour mode = vague bg/fg on the page itself (dark mode just inverts, which is harsher)
startup_commands                         toggle_custom_color
custom_background_color                  0.078 0.078 0.082
custom_text_color                        0.804 0.804 0.804
custom_color_mode_empty_background_color 0.078 0.078 0.082
background_color                         0.078 0.078 0.082
dark_mode_background_color               0.078 0.078 0.082
dark_mode_contrast                       0.8

# UI (menus, command palette, status bar)
ui_font                                  JetBrainsMono Nerd Font
font_size                                15
status_bar_font_size                     13
ui_text_color                            0.804 0.804 0.804
ui_background_color                      0.145 0.145 0.188
ui_selected_text_color                   0.804 0.804 0.804
ui_selected_background_color             0.200 0.216 0.220
status_bar_color                         0.078 0.078 0.082
status_bar_text_color                    0.376 0.376 0.475
# minimal status bar: page count, plus whatever is active (search, marks, modes)
status_bar_format                        %{current_page} / %{num_pages}%{chapter_name}%{search_results}%{search_progress}%{link_status}%{waiting_for_symbol}%{indexing}%{visual_scroll}%{highlight}%{custom_message}

# page chrome
page_separator_width                     2
page_separator_color                     0.078 0.078 0.082

# highlights (yellow selection, blue links, green search, faint ruler)
text_highlight_color                     0.953 0.745 0.486
search_highlight_color                   0.498 0.647 0.388
link_highlight_color                     0.431 0.580 0.698
synctex_highlight_color                  0.733 0.616 0.741
visual_mark_color                        0.145 0.145 0.188 0.6
ruler_color                              0.376 0.376 0.475

# one window: opening a PDF reuses it, so AeroSpace keeps sioyek on workspace R
should_launch_new_window                 0
check_for_updates_on_startup             0
super_fast_search                        1
case_sensitive_search                    0
collapsed_toc                            1
