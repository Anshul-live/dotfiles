# sioyek keys (on top of the bundled keys.config, which is already mostly vim:
# j/k scroll, gg/G, / search, n/N, t toc, m/` marks, b/gb bookmarks, q quit).
# macOS reads ~/.config/sioyek/keys_user.config. Only the missing vim-isms are here.

# half/whole screen like vim (sioyek has no half-screen command)
screen_down        <C-d>
screen_up          <C-u>
# page by page
next_page          J
previous_page      K
# zoom / fit
fit_to_page_width  w
# colours: i flips custom colour mode (vague) <-> plain paper
toggle_custom_color i
toggle_statusbar   <C-s>
