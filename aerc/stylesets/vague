# aerc styleset: vague (same palette as Ghostty/nvim/tmux). Selected by styleset-name = vague
# in aerc.conf; install.sh links stylesets/ -> ~/Library/Preferences/aerc/stylesets.

*.default=true
*.normal=true

title.fg=#6e94b2
title.bold=true
header.fg=#6e94b2
header.bold=true

border.fg=#252530
tab.fg=#606079
tab.bg=#141415
tab.selected.fg=#cdcdcd
tab.selected.bg=#252530
tab.selected.bold=true

statusline_default.fg=#606079
statusline_default.bg=#141415
statusline_error.fg=#d8647e
statusline_success.fg=#7fa563
statusline_warning.fg=#f3be7c

*error.fg=#d8647e
*error.bold=true
*warning.fg=#f3be7c
*success.fg=#7fa563

spinner.fg=#606079

dirlist_default.fg=#cdcdcd
dirlist_unread.fg=#cdcdcd
dirlist_unread.bold=true
dirlist_recent.fg=#cdcdcd
dirlist*.selected.fg=#cdcdcd
dirlist*.selected.bg=#333738
dirlist*.selected.bold=true

# read mail recedes, unread stands out
msglist_default.fg=#606079
msglist_unread.fg=#cdcdcd
msglist_unread.bold=true
msglist_answered.fg=#aeaed1
msglist_flagged.fg=#f3be7c
msglist_deleted.fg=#606079
msglist_deleted.italic=true
msglist_result.fg=#e0a363
msglist_marked.fg=#bb9dbd
msglist_marked.bold=true
msglist_thread_folded.fg=#606079
msglist_*.selected.bg=#333738
msglist_pill.fg=#141415
msglist_pill.bg=#6e94b2

part_*.fg=#cdcdcd
part_mimetype.fg=#606079
part_*.selected.bg=#333738
part_filename.selected.bold=true

completion_default.fg=#cdcdcd
completion_default.bg=#252530
completion_default.selected.bg=#333738
completion_gutter.bg=#252530
completion_pill.bg=#606079
completion_description.fg=#606079

selector_default.fg=#cdcdcd
selector_focused.fg=#141415
selector_focused.bg=#6e94b2
selector_chooser.fg=#cdcdcd
selector_chooser.bg=#333738
selector_chooser.bold=true

default.selected.fg=#cdcdcd
default.selected.bg=#333738

[viewer]
*.default=true
*.normal=true
url.fg=#6e94b2
url.underline=true
header.fg=#6e94b2
header.bold=true
signature.fg=#606079
diff_meta.bold=true
diff_chunk.fg=#aeaed1
diff_add.fg=#7fa563
diff_del.fg=#d8647e
diff_whitespace.bg=#d8647e
quote_*.fg=#606079
quote_1.fg=#aeaed1
code.fg=#e0a363
