#!/usr/bin/env python3
# cp-index: the solutions folder as a list, read from each problem's plan.md frontmatter.
#
#   cp-index                       rewrite <root>/README.md (table of every problem)
#   cp-index --json                print the problems as JSON (nvim's CP-mode browser)
#   cp-index status DIR STATUS     set status (todo / attempted / solved) in DIR/plan.md;
#                                  solved also stamps the date, rewrites README.md,
#                                  commits DIR and pushes
#
# Commits are "<judge> <id>: <title> (<difficulty>)" with only that folder and
# README.md staged, so stray files in the repo are never swept in.
# CP_ROOT overrides the base folder (default ~/Desktop/code/dsa).
import json
import os
import re
import subprocess
import sys
from datetime import date

ROOT = os.path.expanduser(os.environ.get("CP_ROOT", "~/Desktop/code/dsa"))
SKIP = {".git", "build", "include", "bits", ".leetgo"}
JUDGE = {"leetcode": "LeetCode", "codeforces": "Codeforces", "cses": "CSES", "atcoder": "AtCoder"}
ICON = {"solved": "✅", "attempted": "🟡", "todo": "⬜"}
RANK = {"Easy": 0, "Medium": 1, "Hard": 2}


class Fail(Exception):
    pass


def frontmatter(text):
    m = re.match(r"---\n(.*?)\n---\n", text, re.S)
    meta = {}
    for line in (m.group(1) if m else "").splitlines():
        k, sep, v = line.partition(":")
        if not sep:
            continue
        v = v.strip()
        if v.startswith("[") and v.endswith("]"):
            v = [t.strip() for t in v[1:-1].split(",") if t.strip()]
        elif len(v) >= 2 and v[0] == v[-1] == '"':
            v = v[1:-1]
        meta[k.strip()] = v
    return meta


def source(d):
    for name in ("solution.cpp", "main.cpp"):
        if os.path.exists(os.path.join(d, name)):
            return name
    return None


def problems():
    out = []
    for root, dirs, files in os.walk(ROOT):
        dirs[:] = sorted(x for x in dirs if x not in SKIP and not x.startswith("."))
        if "plan.md" not in files:
            continue
        with open(os.path.join(root, "plan.md"), encoding="utf-8") as f:
            meta = frontmatter(f.read())
        meta["dir"] = root
        meta["rel"] = os.path.relpath(root, ROOT)
        meta["src"] = source(root)
        meta["statement"] = next((n for n in ("question.md", "problem.md") if n in files), None)
        meta.setdefault("status", "todo")
        if not isinstance(meta.get("tags"), list):
            meta["tags"] = []
        out.append(meta)
    # newest activity first: solved date, else the day it was started
    out.sort(key=lambda p: (p.get("solved") or p.get("started") or ""), reverse=True)
    return out


def readme(ps):
    solved = [p for p in ps if p["status"] == "solved"]
    by_diff = {}
    for p in solved:
        if p.get("difficulty"):
            by_diff[p["difficulty"]] = by_diff.get(p["difficulty"], 0) + 1
    by_judge = {}
    for p in solved:
        by_judge[p["judge"]] = by_judge.get(p["judge"], 0) + 1
    lines = [
        "# DSA",
        "",
        "Competitive programming solutions in C++. Every problem folder has the plan",
        "(approach, complexity, edge cases, a sketch) written before the code.",
        "",
        "**%d solved**" % len(solved)
        + "".join(" · %s %d" % (d, n) for d, n in sorted(by_diff.items(), key=lambda x: RANK.get(x[0], 9)))
        + "".join(" · %s %d" % (JUDGE.get(j, j), n) for j, n in sorted(by_judge.items()))
        + " · %d in progress" % sum(1 for p in ps if p["status"] != "solved"),
        "",
        "| | Problem | Judge | Difficulty | Tags | Solved |",
        "|---|---|---|---|---|---|",
    ]
    for p in ps:
        title = "%s. %s" % (p.get("id", ""), p.get("title", "")) if p.get("judge") == "leetcode" else p.get("title") or p.get("id", "")
        link = "[%s](%s)" % (title.replace("|", "\\|"), p["rel"].replace(" ", "%20") + "/plan.md")
        lines.append("| %s | %s | %s | %s | %s | %s |" % (
            ICON.get(p["status"], "⬜"), link, JUDGE.get(p.get("judge"), p.get("judge", "")),
            p.get("difficulty", ""), ", ".join(p["tags"]), p.get("solved", "")))
    lines += ["", "_Generated by `cp-index` from each folder's `plan.md`._", ""]
    with open(os.path.join(ROOT, "README.md"), "w") as f:
        f.write("\n".join(lines))


def git(*args, check=True):
    r = subprocess.run(["git", "-C", ROOT, *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        raise Fail("git %s: %s" % (args[0], (r.stderr or r.stdout).strip()))
    return r


def set_status(d, status):
    d = os.path.abspath(os.path.expanduser(d))
    plan = os.path.join(d, "plan.md")
    if not os.path.exists(plan):
        raise Fail("no plan.md in " + d)
    with open(plan, encoding="utf-8") as f:
        text = f.read()
    text = re.sub(r"^status:.*$", "status: " + status, text, count=1, flags=re.M)
    if status == "solved":
        text = re.sub(r"^solved:.*$", "solved: " + date.today().isoformat(), text, count=1, flags=re.M)
    with open(plan, "w", encoding="utf-8") as f:
        f.write(text)
    if status != "solved":
        return "cp-index: %s → %s" % (os.path.relpath(d, ROOT), status)

    readme(problems())
    if git("rev-parse", "--git-dir", check=False).returncode != 0:
        return "cp-index: solved (README updated; %s is not a git repo)" % ROOT
    meta = frontmatter(text)
    msg = "%s %s: %s" % (meta.get("judge", ""), meta.get("id", ""), meta.get("title", ""))
    if meta.get("difficulty"):
        msg += " (%s)" % meta["difficulty"]
    git("add", "--", d, os.path.join(ROOT, "README.md"))
    if git("diff", "--cached", "--quiet", check=False).returncode == 0:
        return "cp-index: solved, nothing new to commit"
    git("commit", "-q", "-m", msg)
    if git("remote", check=False).stdout.strip():
        r = git("push", "-q", check=False)
        if r.returncode != 0:
            return "cp-index: committed '%s', push failed: %s" % (msg, r.stderr.strip())
        return "cp-index: committed and pushed '%s'" % msg
    return "cp-index: committed '%s' (no remote)" % msg


def main(argv):
    if argv[:1] == ["--json"]:
        print(json.dumps(problems()))
    elif argv[:1] == ["status"] and len(argv) == 3:
        if argv[2] not in ICON:
            raise Fail("status is one of: " + ", ".join(ICON))
        print(set_status(argv[1], argv[2]))
    elif not argv:
        ps = problems()
        readme(ps)
        print("cp-index: README.md lists %d problems" % len(ps))
    else:
        raise Fail("usage: cp-index [--json | status DIR todo|attempted|solved]")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except Fail as e:
        print(str(e), file=sys.stderr)
        sys.exit(1)
