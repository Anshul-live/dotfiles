#!/usr/bin/env bash
# Pick a project, jump into its tmux session.
# First visit creates the session, one full-screen window each:
#   1 code   nvim (restores your last session)
#   2 run    a shell for servers, builds, scripts
#   3 git    lazygit
# Per-project override: an executable .tmux-layout in the project replaces those
# windows. It runs as `.tmux-layout <session> <dir>` after the session exists
# (window 1 is an empty shell named "code", so it can respawn or rename it), e.g.
#   #!/usr/bin/env bash
#   tmux respawn-window -k -t "=$1:1" nvim
#   tmux new-window -dt "=$1:" -c "$2" -n api 'npm run dev'
# Window 1 is selected afterwards either way.
#   tmux-sessionizer            fuzzy-pick a project
#   tmux-sessionizer <dir>      go straight to <dir>
set -euo pipefail

roots=("$HOME/Desktop/code" "$HOME/Desktop/code/project")
extra=("$HOME/dotfiles")

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(
    {
      find "${roots[@]}" -mindepth 1 -maxdepth 1 -type d ! -name '.*' 2>/dev/null
      printf '%s\n' "${extra[@]}"
    } | sed "s|^$HOME|~|" | sort -u |
      fzf --prompt='project  ' --layout=reverse --border=sharp --info=inline \
        --color='bg:#141415,bg+:#252530,fg:#cdcdcd,fg+:#cdcdcd,hl:#6e94b2,hl+:#6e94b2,border:#606079,prompt:#6e94b2,pointer:#6e94b2,info:#606079' \
      || true
  )
  selected=${selected/#\~/$HOME}
fi
[[ -z ${selected:-} ]] && exit 0

name=$(basename "$selected" | tr '.:' '__')

if ! tmux has-session -t "=$name" 2>/dev/null; then
  if [[ -x $selected/.tmux-layout ]]; then
    tmux new-session -ds "$name" -c "$selected" -n code
    (cd "$selected" && ./.tmux-layout "$name" "$selected") ||
      tmux display-message ".tmux-layout failed in $selected"
  else
    tmux new-session -ds "$name" -c "$selected" -n code nvim
    tmux new-window -dt "=$name:" -c "$selected" -n run
    # lazygit exits outside a repo; fall back to a shell so the window survives
    tmux new-window -dt "=$name:" -c "$selected" -n git 'lazygit || exec "$SHELL"'
  fi
  tmux select-window -t "=$name:^"
fi

if [[ -n ${TMUX:-} ]]; then
  tmux switch-client -t "=$name"
else
  tmux attach-session -t "=$name"
fi
