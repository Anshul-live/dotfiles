#!/usr/bin/env bash
# Open URLs (or :commands) in qutebrowser from anything: AeroSpace, yazi, newsboat, aerc, nvim.
#   qb                    make sure it's running (new window only if it wasn't)
#   qb <url|:cmd>...      open in the running instance, starting it first if needed
#   qb -w [url]           exactly one new window (AeroSpace setups wait for it)
# qutebrowser here is a pip install (uv), not an .app, and macOS hands a non-bundled app's
# command-line arguments back to it as files to open: `qutebrowser URL` on a cold start
# shows file:///<cwd>/URL. So a cold start gets no arguments; they follow over IPC once it
# listens (`--target window` etc. pass through untouched).
set -euo pipefail

q="$HOME/.local/bin/qutebrowser"
# qutebrowser's runtime dir, where the IPC socket (i-<hash>) lives while it runs
sock_dir="$(getconf DARWIN_USER_TEMP_DIR)qutebrowser"

running() { pgrep -qf 'uv/tools/qutebrowser/bin/python'; }
listening() { compgen -G "$sock_dir/i-*" >/dev/null; }

new_window=0
[[ ${1:-} == -w ]] && { new_window=1; shift; }

if running; then
	((new_window)) && set -- ":open -w ${1:-about:blank}"
else
	nohup "$q" >/dev/null 2>&1 &
	[[ $# -eq 0 ]] && exit 0
	for _ in $(seq 150); do listening && break; sleep 0.1; done
	# the fresh window shows the start page: load the first URL there instead of a 2nd tab
	[[ $1 == :* || $1 == -* ]] || set -- ":open $1" "${@:2}"
fi
[[ $# -eq 0 ]] && exit 0
exec "$q" "$@" >/dev/null 2>&1
