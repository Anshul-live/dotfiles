#!/usr/bin/env bash
# Minimal bar: a flat strip over the menu bar. Workspaces + mode on the left, time + battery on the right.

source "$HOME/.config/sketchybar/variables.sh" # Loads all defined colors

sketchybar --bar height=32 \
	color="$BAR_COLOR" \
	shadow=off \
	position=top \
	sticky=on \
	padding_left=12 \
	padding_right=12 \
	notch_width=200 \
	--default updates=when_shown \
	icon.font="$FONT:Regular:13.0" \
	icon.color="$ICON_COLOR" \
	icon.padding_left=0 \
	icon.padding_right=0 \
	label.font="$FONT:Regular:12.0" \
	label.color="$LABEL_COLOR" \
	label.padding_left=0 \
	label.padding_right=0 \
	background.drawing=off \
	popup.background.border_width=1 \
	popup.background.corner_radius="$CORNER_RADIUS" \
	popup.background.border_color="$POPUP_BORDER_COLOR" \
	popup.background.color="$POPUP_BACKGROUND_COLOR"

# Left
source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/mode.sh" # AeroSpace WINDOW mode badge + cheat-sheet
source "$ITEM_DIR/front_app.sh"

# Right
source "$ITEM_DIR/clock.sh"
source "$ITEM_DIR/battery.sh"

sketchybar --hotload true
sketchybar --update
