# khal / ikhal: calendar, window "cal" of the tmux session "comms" (bin/ws-session).
# install.sh links this to ~/.config/khal/config. Events are the .ics files vdirsyncer
# (vdirsyncer/config) syncs from Google into ~/.local/share/calendars/<calendar>/.

[calendars]
# one khal calendar per Google calendar; name and colour come from Google (vdirsyncer metasync)
[[google]]
path = ~/.local/share/calendars/*
type = discover
color = auto
# lets ikhal show your own accept/decline status on invites
addresses = itsanshulkumar03@gmail.com

[locale]
# Monday first (ISO weeks, India); 24h clock; day before month everywhere
firstweekday = 0
timeformat = %H:%M
dateformat = %d %b
longdateformat = %d %b %Y
datetimeformat = %d %b %H:%M
longdatetimeformat = %d %b %Y %H:%M
weeknumbers = right

[default]
# new events go to the main Google calendar, whose folder is named after the address
default_calendar = itsanshulkumar03@gmail.com
highlight_event_days = True
timedelta = 7d
default_event_alarm = 10m

[view]
frame = color
dynamic_days = True
min_calendar_display = 2
agenda_day_format = "{bold}{name}, {date-long}{reset}"

[highlight_days]
method = fg
default_color = '#6e94b2'

# ikhal colours: vague. Each entry: low-colour fg, bg, mono, then 24-bit fg, bg (quoted).
[palette]
header = white, black, bold, '#cdcdcd', '#141415'
footer = white, black, '', '#606079', '#141415'
line header = white, black, bold, '#6e94b2', '#141415'
