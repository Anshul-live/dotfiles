bright = white, '', bold, '#cdcdcd', ''
list = white, '', '', '#cdcdcd', ''
list focused = white, dark gray, bold, '#cdcdcd', '#333738'
edit = white, '', '', '#cdcdcd', '#252530'
edit focus = white, dark gray, bold, '#cdcdcd', '#333738'
button = white, dark gray, '', '#cdcdcd', '#252530'
button focused = black, light blue, bold, '#141415', '#6e94b2'
reveal focus = white, dark gray, bold, '#cdcdcd', '#333738'
today = yellow, '', bold, '#f3be7c', ''
today focus = black, yellow, bold, '#141415', '#f3be7c'
date header = light gray, '', '', '#606079', ''
date header focused = white, dark gray, bold, '#cdcdcd', '#333738'
date header selected = white, '', bold, '#aeaed1', '#252530'
dayname = light gray, '', '', '#606079', ''
monthname = light gray, '', '', '#bb9dbd', ''
weeknumber_right = dark gray, '', '', '#606079', ''
alert = white, dark red, bold, '#141415', '#d8647e'
